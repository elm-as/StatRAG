# Connexion PostgreSQL 16+ avec extension pgvector activée (ELMAS.md §9)
STATRAG_DATABASE_URL=postgresql://statrag_app:change_me@127.0.0.1:5432/statrag

# Identifiant d'organisation injecté dans la session SQL pour appliquer Row-Level Security
STATRAG_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
